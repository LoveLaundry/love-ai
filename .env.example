# ── Connection ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=laundry_management

# Optional: point at the same three-database layout as laundry-management
# MONGODB_MAIN_URI=
# MONGODB_MAIN_DB=

# ── Security ──────────────────────────────────────────────────────────────────
# Shared master key MUST be identical to laundry-management's MASTER_KEY so
# the AI service can decrypt envelope-encrypted PII for analytics.
MASTER_KEY=CHANGE-ME-IN-PRODUCTION-love-laundry-2026

# API keys granted access to the AI service. Separate multiple keys with commas.
# These are stored as HMAC-SHA256 hashes automatically (plaintext never persisted).
LOVE_AI_API_KEYS=dev-key-change-me

# Optional: enable JWT passthrough verification (user-service's JWT_SECRET)
# JWT_SECRET=CHANGE-ME-IN-PRODUCTION-love-laundry-2026

# Request signature window (seconds) to accept a signed request
SIGNATURE_TTL_SECONDS=300

# ── Behaviour ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://lovelaundry-manager.vercel.app"]
RATE_LIMIT_PER_MINUTE=120